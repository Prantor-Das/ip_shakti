# Google Gemini API key for IP-SAKTI Sahayak AI Assistant
GEMINI_API_KEY=your_gemini_api_key_here
# Optional model overrides. Defaults are safe for the current Gemini API.
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Bhashini server-side translation credentials and the selected translation pipeline.
# BHASHINI_PIPELINE_ID is obtained from the Bhashini/ULCA portal.
BHASHINI_USER_ID=your_bhashini_user_id_here
BHASHINI_ULCA_API_KEY=your_bhashini_ulca_api_key_here
BHASHINI_PIPELINE_ID=your_bhashini_pipeline_id_here
# Optional translation model override.
# GEMINI_TRANSLATION_MODEL=gemini-3.8-flash
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key
RETRIEVAL_MIN_SIMILARITY=0.55
RETRIEVAL_HIGH_SIMILARITY=0.78
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=privacy@example.org

# Request safety and budgets
REQUEST_TIMEOUT_MS=30000
MAX_OUTPUT_TOKENS=4096
RATE_LIMIT_SALT=replace-with-a-random-server-secret
CHAT_RATE_LIMIT_PER_MINUTE=10
CHAT_RATE_LIMIT_PER_DAY=100
CONTACT_RATE_LIMIT_PER_HOUR=3
MAX_INFLIGHT_PER_CLIENT=1
GLOBAL_DAILY_REQUEST_BUDGET=1000
GLOBAL_DAILY_TOKEN_BUDGET=1000000
LOG_CONTENT=false
AUDIT_RETENTION_DAYS=90

# Optional distributed rate limiting
# UPSTASH_REDIS_REST_URL=https://...
# UPSTASH_REDIS_REST_TOKEN=...

# Contact delivery (choose resend or smtp)
# CONTACT_PROVIDER=resend
# CONTACT_TO_EMAIL=team@example.org
# CONTACT_FROM_EMAIL=IP-SAKTI <no-reply@example.org>
# RESEND_API_KEY=...
# CONTACT_PROVIDER=smtp
# SMTP_HOST=smtp.example.org
# SMTP_PORT=587
# SMTP_USER=...
# SMTP_PASSWORD=...

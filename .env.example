# IP-SAKTI Sahayak configuration
# Copy this file to .env.local. Values below are placeholders only.
# The server fails fast with a readable list if a required variable is missing or invalid.

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
# OPTIONAL — set by the deployment platform; defaults to development.
NODE_ENV=development

# -----------------------------------------------------------------------------
# Gemini
# -----------------------------------------------------------------------------
# REQUIRED — create a server-side key in Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=replace-with-google-ai-studio-key
# OPTIONAL — model IDs from https://ai.google.dev/gemini-api/docs/models.
GEMINI_MODEL=gemini-3.8-flash
# OPTIONAL — fallback model ID from the Gemini model list.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# OPTIONAL — translation fallback model ID from the Gemini model list.
GEMINI_TRANSLATION_MODEL=gemini-3.8-flash
# OPTIONAL — embedding model ID; defaults to gemini-embedding-001.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# OPTIONAL — must match the configured pgvector dimension; defaults to 768.
EMBEDDING_DIM=768

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
# REQUIRED — Supabase project URL from Project Settings → Data API.
SUPABASE_URL=https://your-project.supabase.co
# REQUIRED — server-only service_role key from Project Settings → API. Never prefix it NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key

# -----------------------------------------------------------------------------
# Retrieval
# -----------------------------------------------------------------------------
# OPTIONAL — minimum cosine similarity; defaults to 0.55.
RETRIEVAL_MIN_SIMILARITY=0.55
# OPTIONAL — high-confidence similarity threshold; defaults to 0.78.
RETRIEVAL_HIGH_SIMILARITY=0.78
# OPTIONAL — upstream request timeout in milliseconds; defaults to 30000.
REQUEST_TIMEOUT_MS=30000
# OPTIONAL — maximum generated output tokens; defaults to 4096.
MAX_OUTPUT_TOKENS=4096

# -----------------------------------------------------------------------------
# Bhashini translation
# -----------------------------------------------------------------------------
# OPTIONAL — obtain all three values from the Bhashini/ULCA account and pipeline configuration.
# BHASHINI_USER_ID=replace-with-bhashini-user-id
# OPTIONAL — obtain from the Bhashini/ULCA account; set together with the other Bhashini values.
# BHASHINI_ULCA_API_KEY=replace-with-bhashini-api-key
# OPTIONAL — obtain from the selected Bhashini translation pipeline.
# BHASHINI_PIPELINE_ID=replace-with-bhashini-pipeline-id

# -----------------------------------------------------------------------------
# Rate limiting and daily budget
# -----------------------------------------------------------------------------
# OPTIONAL — random server secret used to hash client identifiers; generate with a password manager.
RATE_LIMIT_SALT=replace-with-rate-limit-salt
# OPTIONAL — Upstash REST URL from the Upstash console; omit both Upstash values for in-memory fallback.
# UPSTASH_REDIS_REST_URL=https://your-upstash-endpoint.upstash.io
# OPTIONAL — Upstash REST token from the Upstash console.
# UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-rest-token
# OPTIONAL — chat requests per client per minute; defaults to 10.
CHAT_RATE_LIMIT_PER_MINUTE=10
# OPTIONAL — chat requests per client per day; defaults to 100.
CHAT_RATE_LIMIT_PER_DAY=100
# OPTIONAL — contact requests per client per hour; defaults to 3.
CONTACT_RATE_LIMIT_PER_HOUR=3
# OPTIONAL — concurrent requests per client, from 1 to 2; defaults to 1.
MAX_INFLIGHT_PER_CLIENT=1
# OPTIONAL — global requests allowed per UTC day; defaults to 1000.
DAILY_BUDGET_REQUESTS=1000
# OPTIONAL — global estimated input tokens allowed per UTC day; defaults to 1000000.
DAILY_BUDGET_TOKENS=1000000

# -----------------------------------------------------------------------------
# Audit and privacy
# -----------------------------------------------------------------------------
# OPTIONAL — separate random server secret for audit client-ID hashes; falls back to RATE_LIMIT_SALT.
# AUDIT_SALT=replace-with-audit-salt
# OPTIONAL — set true only with an approved privacy/legal decision; defaults to false.
LOG_CONTENT=false
# OPTIONAL — audit record retention used by audit:prune; defaults to 90 days.
AUDIT_RETENTION_DAYS=90

# -----------------------------------------------------------------------------
# Contact delivery
# -----------------------------------------------------------------------------
# OPTIONAL — choose resend or smtp to enable the contact endpoint.
# CONTACT_PROVIDER=resend
# OPTIONAL — destination mailbox configured by the operator.
# CONTACT_TO_EMAIL=contact@example.invalid
# OPTIONAL — verified sender address for the selected provider.
# CONTACT_FROM_EMAIL=no-reply@example.invalid
# OPTIONAL — create in the Resend dashboard when CONTACT_PROVIDER=resend.
# RESEND_API_KEY=replace-with-resend-api-key
# OPTIONAL — SMTP hostname when CONTACT_PROVIDER=smtp.
# SMTP_HOST=smtp.example.invalid
# OPTIONAL — SMTP port when CONTACT_PROVIDER=smtp.
# SMTP_PORT=587
# OPTIONAL — SMTP username when CONTACT_PROVIDER=smtp.
# SMTP_USER=replace-with-smtp-username
# OPTIONAL — SMTP password when CONTACT_PROVIDER=smtp.
# SMTP_PASSWORD=replace-with-smtp-password

# -----------------------------------------------------------------------------
# Public configuration
# -----------------------------------------------------------------------------
# OPTIONAL — public origin used for same-origin checks and metadata; defaults to localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# OPTIONAL — public privacy/contact address displayed by the UI.
NEXT_PUBLIC_CONTACT_EMAIL=contact@example.invalid
# OPTIONAL — legacy facilitator escalation address displayed when the contact email is unset.
NEXT_PUBLIC_FACILITATOR_EMAIL=facilitator@example.invalid
# OPTIONAL — reserved public feature flag for the voice experience; defaults to false.
NEXT_PUBLIC_ENABLE_VOICE=false

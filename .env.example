# Google Gemini API key for IP-SAKTI Sahayak AI Assistant
GEMINI_API_KEY=your_gemini_api_key_here
# Optional model overrides. Defaults are safe for the current Gemini API.
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key
RETRIEVAL_MIN_SIMILARITY=0.55
RETRIEVAL_HIGH_SIMILARITY=0.78
# Optional; when unset, facilitator escalation is hidden.
# NEXT_PUBLIC_FACILITATOR_EMAIL=facilitator@example.org
